#!/usr/bin/env bash
# Runs `sbt scalafmtAll` before every commit and re-stages whatever it
# reformats, so commits never carry unformatted Scala. Installed via
# `git config core.hooksPath hooks` (see CLAUDE.md).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

staged_scala_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.scala')

if [ -z "$staged_scala_files" ]; then
  exit 0
fi

echo "pre-commit: running scalafmtAll..."
if ! sbt -batch scalafmtAll; then
  echo "pre-commit: scalafmtAll failed, aborting commit." >&2
  exit 1
fi

# Re-stage only files that were already staged, in case formatting touched them.
while IFS= read -r file; do
  [ -f "$file" ] && git add -- "$file"
done <<< "$staged_scala_files"

exit 0
